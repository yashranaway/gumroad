#!/usr/bin/env python3
"""Marketing-marker check for a feature PR (Sahil, 2026-10-23).

A feature merges WITH its marketing artifacts — the announcement mail and the social posts are part
of shipping it, not a follow-up. Run by .github/workflows/marketing-readiness.yml as the
`marketing/ready` status check, which is listed in the `main` ruleset, so this is the one gate a
human merge from the UI also passes through.

The PR body carries ONE line, pinned to the head commit:

    Marketing: ready @ <head-sha> (mail: <draft ref>; social: <draft ref>)
    Marketing: exempt (<short reason>) @ <head-sha>

`ready` needs BOTH refs, and they are drafts, not sends: the announcement goes out after the deploy,
through its own approval gate. `exempt` covers the classes we never announce (bug fixes, SEO/meta/
copy, deps, infra, tests, internal tooling) and a feature that cannot clear the creator-earnings
framing.

Inputs are the environment (the workflow passes the pull_request payload): PR_BODY, PR_HEAD,
PR_DRAFT. Exit 0 clear, 1 owed.

The same grammar is mirrored locally in ~/.hermes/scripts/feature_marketing_gate.py, which blocks
`gh pr merge` and lists the PRs that owe the marker. Keep the two in step.
"""
import os
import re
import sys

READY = re.compile(r"Marketing:\s*ready\b[^\n]*?@\s*([0-9a-f]{7,40})", re.I)
EXEMPT = re.compile(r"Marketing:\s*exempt\s*\(([^)\n]{3,})\)[^\n]*?@\s*([0-9a-f]{7,40})", re.I)
MAIL = re.compile(r"mail:\s*\S*[A-Za-z0-9]", re.I)
SOCIAL = re.compile(r"social:\s*\S*[A-Za-z0-9]", re.I)

MESSAGE = """⛔ Feature PRs merge WITH their marketing artifacts (Sahil, 2026-10-23).

Add ONE line to the PR description, pinned to the current head commit:

  Marketing: ready @ <head-sha> (mail: <draft ref>; social: <draft ref>)
  Marketing: exempt (<short reason>) @ <head-sha>

  ready   both refs are required: the drafted announcement mail and the drafted feature posts.
          Drafts, not sends — the announcement goes out after the deploy, through its approval
          gate. Editing this body re-runs the check; no push needed.
  exempt  bug fix (we never announce a fix), SEO/meta/copy, deps, infra, tests, internal tooling,
          or a feature that cannot clear the creator-earnings framing.

Why: {why}"""


def check(body, head, draft):
    """(ok, detail). Drafts are skipped: a draft cannot merge, and the marker is owed before it is
    presented for merge (the check re-runs on ready_for_review)."""
    if draft:
        return True, "draft — the marker is owed before this is presented for merge"
    body, head = body or "", (head or "").lower()
    for m in EXEMPT.finditer(body):
        if head.startswith(m.group(2).lower()):
            return True, f"exempt ({m.group(1).strip()})"
    for m in READY.finditer(body):
        start = body.rfind("\n", 0, m.start()) + 1
        end = body.find("\n", m.end())
        line = body[start:end if end != -1 else len(body)]
        if MAIL.search(line) and SOCIAL.search(line) and head.startswith(m.group(1).lower()):
            return True, line.strip()
    if READY.search(body) or EXEMPT.search(body):
        return False, "the Marketing: line is pinned to an older commit — update the sha after a push"
    return False, "no Marketing: line in the PR body"


def main():
    ok, detail = check(os.environ.get("PR_BODY"), os.environ.get("PR_HEAD"),
                       (os.environ.get("PR_DRAFT") or "").lower() == "true")
    if ok:
        print(f"marketing: {detail}")
        return 0
    print(MESSAGE.format(why=detail), file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
